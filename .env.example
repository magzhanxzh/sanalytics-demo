# Все переменные необязательны. Без них демо работает полностью офлайн.

# Ключ Anthropic: ИИ-аналитик начнёт отвечать через Claude поверх демо-слоя метрик.
# Без ключа чат отдаёт шаблонный ответ по тем же числам.
ANTHROPIC_API_KEY=

# 1 = использовать настоящие API-клиенты рекламных кабинетов, AppsFlyer и Telegram
# с кредами, введёнными в UI. По умолчанию выключено: внешних запросов нет.
SANALYTICS_LIVE_CONNECTORS=
