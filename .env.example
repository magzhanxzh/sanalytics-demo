# All variables are optional. Without them the demo runs fully offline.

# Anthropic key: the AI analyst will answer through Claude over the demo metrics layer.
# Without a key the chat returns a templated answer with the same numbers.
ANTHROPIC_API_KEY=

# 1 = use the real API clients for ad accounts, AppsFlyer and Telegram
# with credentials entered in the UI. Off by default: no external requests.
SANALYTICS_LIVE_CONNECTORS=
